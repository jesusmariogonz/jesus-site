{
  "name": "Retail PDV — Jesús González",
  "dataColors": [
    "#B0611C",
    "#1B2A36",
    "#2F6B4F",
    "#4E7A96",
    "#C9913E",
    "#9B3B34",
    "#6E7C86",
    "#7A5C3E",
    "#3E6B7A",
    "#A8A093",
    "#54606B",
    "#D8C3A5"
  ],
  "foreground": "#1B2A36",
  "foregroundNeutralSecondary": "#4A5A66",
  "foregroundNeutralTertiary": "#6E7C86",
  "background": "#FFFFFF",
  "backgroundLight": "#F3F1EC",
  "backgroundNeutral": "#E7E3DA",
  "tableAccent": "#B0611C",
  "good": "#2F6B4F",
  "neutral": "#C9913E",
  "bad": "#9B3B34",
  "maximum": "#1B2A36",
  "center": "#C9913E",
  "minimum": "#F3F1EC",
  "null": "#E7E3DA",
  "hyperlink": "#B0611C",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 15,
      "color": "#1B2A36"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#1B2A36"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#1B2A36"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 34,
      "color": "#1B2A36"
    },
    "largeTitle": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 20,
      "color": "#1B2A36"
    },
    "lightLabel": {
      "fontFace": "Segoe UI",
      "fontSize": 9,
      "color": "#6E7C86"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E7E3DA"
              }
            },
            "radius": 4
          }
        ],
        "visualHeader": [
          {
            "show": true,
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "foreground": {
              "solid": {
                "color": "#6E7C86"
              }
            }
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#1B2A36"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "alignment": "left",
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F3F1EC"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#E7E3DA"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#1B2A36"
              }
            },
            "fontSize": 30,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#6E7C86"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "kpi": {
      "*": {
        "indicator": [
          {
            "fontSize": 28,
            "color": {
              "solid": {
                "color": "#1B2A36"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#B0611C"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold",
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#1B2A36"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E7E3DA"
              }
            },
            "rowPadding": 3,
            "outlineColor": {
              "solid": {
                "color": "#E7E3DA"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#2E4150"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#1B2A36"
              }
            },
            "fontSize": 9,
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F8F7F4"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#2E4150"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#1B2A36"
              }
            },
            "fontSize": 9
          }
        ],
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E7E3DA"
              }
            }
          }
        ]
      }
    },
    "columnChart": {
      "*": {
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "gridlineShow": false,
            "labelColor": {
              "solid": {
                "color": "#4A5A66"
              }
            },
            "fontSize": 9
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "gridlineColor": {
              "solid": {
                "color": "#E7E3DA"
              }
            },
            "gridlineStyle": "dotted",
            "labelColor": {
              "solid": {
                "color": "#6E7C86"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "gridlineShow": false,
            "labelColor": {
              "solid": {
                "color": "#4A5A66"
              }
            },
            "fontSize": 9
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "gridlineColor": {
              "solid": {
                "color": "#E7E3DA"
              }
            },
            "gridlineStyle": "dotted",
            "fontSize": 9
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "gridlineShow": false,
            "fontSize": 9
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "gridlineColor": {
              "solid": {
                "color": "#E7E3DA"
              }
            },
            "gridlineStyle": "dotted",
            "fontSize": 9
          }
        ],
        "lineStyles": [
          {
            "strokeWidth": 2,
            "showMarker": false
          }
        ]
      }
    }
  }
}